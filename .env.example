# Copy this file to ".env" and fill in your own values.
# The .env stays on your machine and is never printed or committed.

# --- Azure OpenAI (what the live demo runs on) -----------------------------
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
SERPAPI_API_KEY=your-serpapi-key

# --- Prefer standard OpenAI instead? ---------------------------------------
# Then use OpenAI() instead of AzureOpenAI() in agent.py (see README) and set:
# OPENAI_API_KEY=sk-...
# SERPAPI_API_KEY=your-serpapi-key
